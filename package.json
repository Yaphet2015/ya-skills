{
  "name": "ya-skills",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "packages/*"
  ],
  "bin": {
    "yk": "./packages/cli/dist/cli.js"
  },
  "scripts": {
    "dev": "bun packages/cli/src/cli.ts",
    "build": "bun build --target=node --outfile=packages/cli/dist/cli.js packages/cli/src/cli.ts",
    "build:binary:macos-arm64": "bun build --compile --target=bun-macos-arm64 --outfile=dist/yk packages/cli/src/cli.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "smoke": "bun packages/cli/src/cli.ts list && bun packages/cli/src/cli.ts demo echo hello && node packages/cli/dist/cli.js list && node packages/cli/dist/cli.js demo echo hello"
  },
  "devDependencies": {
    "@types/bun": "^1.3.2",
    "typescript": "^5.9.3"
  }
}
