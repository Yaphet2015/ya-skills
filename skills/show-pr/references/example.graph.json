  "design": [
    {
      "title": "批量大小：每批 500 封还是逐封发送？",
      "context": "以前每个收件人打一次接口。2,000 人的广播要打 2,000 次 Postmark。经常撞上限。发完全部要 40 分钟。",
      "options": [
        {
          "label": "维持逐封发送",
          "summary": "不改代码，但限流与耗时问题原样保留。"
        },
        {
          "label": "每批 500 封（批量端点）",
          "summary": "Postmark /email/batch 的单次上限正好是 500。"
        },
        {
          "label": "每批 1,000 封（自建并发）",
          "summary": "需要自己拆分并发、限速与重试，复杂度最高。"
        }
      ],
      "chosen": "每批 500 封（批量端点）",
      "rationale": "Postmark 一次最多收 500 封。选这个上限，就不必自己做并发和限速。失败时整批再试。请求次数从 2,000 降到 4。"
    },
    {
      "title": "不许发的邮箱名单：什么时候拉？",
      "context": "以前发送时对人逐个查不许发的邮箱名单。同一份名单被问很多次。",
      "options": [
        {
          "label": "每个收件人查一次",
          "summary": "实时性最好，但查询次数与收件人数相同。"
        },
        {
          "label": "每路广播拉取一次全量",
          "summary": "一次 GET 拉全量，之后本地过滤。"
        }
      ],
      "chosen": "每路广播拉取一次全量",
      "rationale": "这份名单很少变。一路广播拉一次全量，查询次数从「和收件人数一样多」变成 1 次。任何一批发出去之前就已经滤完。"
    }
  ],
