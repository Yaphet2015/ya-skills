  "design": [
    {
      "title": "批量大小：每批 500 封还是逐封发送？",
      "context": "旧路径每个收件人一次 API 调用，2,000 人的广播要打 2,000 次 Postmark，频繁触发限流，全量发送要 40 分钟。",
      "options": [
        {
          "label": "维持逐封发送",
          "summary": "不改代码，但限流与耗时问题原样保留。"
        },
        {
          "label": "每批 500 封（批量端点）",
          "summary": "Postmark /email/batch 的单次上限正好是 500。"
        },
        {
          "label": "每批 1,000 封（自建并发）",
          "summary": "需要自己拆分并发、限速与重试，复杂度最高。"
        }
      ],
      "chosen": "每批 500 封（批量端点）",
      "rationale": "供应商批量端点单次上限就是 500：选它不需要自建并发控制，失败按整批重试，复杂度最低，请求次数从 2,000 降到 4。"
    },
    {
      "title": "抑制名单：何时拉取？",
      "context": "旧路径在发送时逐个检查抑制名单，同一个名单被反复查询。",
      "options": [
        {
          "label": "每个收件人查一次",
          "summary": "实时性最好，但查询次数与收件人数相同。"
        },
        {
          "label": "每路广播拉取一次全量",
          "summary": "一次 GET 拉全量，之后本地过滤。"
        }
      ],
      "chosen": "每路广播拉取一次全量",
      "rationale": "抑制名单变动频率低；一次全量拉取把 O(n) 次查询降为 1 次，任何批次发出前就已过滤完毕。"
    }
  ],
