{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "types": ["bun"],
    "outDir": "dist",
    "baseUrl": ".",
    "paths": {
      "@ya-skills/core": ["packages/core/src/index.ts"],
      "@ya-skills/functions-demo": ["packages/functions-demo/src/index.ts"],
      "@ya-skills/functions-pbench": ["packages/functions-pbench/src/index.ts"]
    }
  },
  "include": ["packages/**/*.ts", "tests/**/*.ts"]
}
